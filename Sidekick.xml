<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
    <!-- Edge Glow Frame for Low Health Indicator -->
    <Frame name="SidekickEdgeFrame" parent="UIParent" hidden="true" frameStrata="HIGH">
        <Size x="0" y="0"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <!-- Top Edge -->
        <Layer level="OVERLAY">
            <Texture name="$parentTopEdge" setAllPoints="false">
                <Size x="0" y="100"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="UIParent" relativePoint="TOP">
                        <Offset x="0" y="0"/>
                    </Anchor>
                </Anchors>
            </Texture>

            <!-- Bottom Edge -->
            <Texture name="$parentBottomEdge" setAllPoints="false">
                <Size x="0" y="100"/>
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="UIParent" relativePoint="BOTTOM">
                        <Offset x="0" y="0"/>
                    </Anchor>
                </Anchors>
            </Texture>

            <!-- Left Edge -->
            <Texture name="$parentLeftEdge" setAllPoints="false">
                <Size x="100" y="0"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="UIParent" relativePoint="LEFT">
                        <Offset x="0" y="0"/>
                    </Anchor>
                </Anchors>
            </Texture>

            <!-- Right Edge -->
            <Texture name="$parentRightEdge" setAllPoints="false">
                <Size x="100" y="0"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="UIParent" relativePoint="RIGHT">
                        <Offset x="0" y="0"/>
                    </Anchor>
                </Anchors>
            </Texture>
        </Layer>
    </Frame>
</Ui>
